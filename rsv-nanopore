# Function to choose RSV type
choose_rsv_type() {
    while true; do
        echo -e "${MAGENTA}🔬 Which RSV type are you analyzing?${NC}"
        echo -e "   ${GREEN}[A]${NC} RSV A"
        echo -e "   ${GREEN}[B]${NC} RSV B"
        echo -e "   ${GREEN}[C]${NC} Auto-detect subtype"
        echo ""
        read -p "$(echo -e "${CYAN}Enter your choice [A/B/C]: ${NC}")" choice
        
        case $choice in
            [Aa])
                RSV_TYPE="A"
                REF_NAME="PP109421.1.fasta"
                BED_NAME="RSV_750_primers_PP109421.bed"
                echo -e "${GREEN}✓ Selected RSV A${NC}"
                break
                ;;
            [Cc])
                AUTO_DETECT=1; RSV_TYPE="AUTO"; REF_NAME="PP109421.1.fasta"; BED_NAME="RSV_750_primers_PP109421.bed"
                echo -e "${YELLOW}✓ Auto-detection selected${NC}"; break
                ;;
            [Bb])
                RSV_TYPE="B"
                REF_NAME="OP975389.1.fasta"
                BED_NAME="RSV_750_primers_OP975389.bed"
                echo -e "${GREEN}✓ Selected RSV B${NC}"
                break
                ;;
            *)
                echo -e "${RED}❌ Invalid choice. Please enter A or B.${NC}"
                ;;
        esac
    done
    echo ""
}

# Choose the primer BED scheme independently from the RSV reference.
choose_primer_scheme() {
    while true; do
        echo -e "${MAGENTA}🧬 Which primer BED scheme are you using?${NC}"
        echo -e "   ${GREEN}[1]${NC} My RSV-750 primers (packaged)"
        echo -e "   ${GREEN}[2]${NC} ARTIC primers"
        echo -e "   ${GREEN}[3]${NC} Other/custom BED file"
        read -r -p "$(echo -e "${CYAN}Enter your choice [1-3]: ${NC}")" choice
        case "$choice" in
            1) PRIMER_SCHEME="RSV-750"; CUSTOM_BED=0; echo -e "${GREEN}✓ Selected packaged RSV-750 primer scheme${NC}"; break ;;
            2)
                PRIMER_SCHEME="ARTIC"; CUSTOM_BED=0; BED_FILE=""
                for candidate in "$PWD"/*[Aa][Rr][Tt][Ii][Cc]*.bed "$HOME"/*[Aa][Rr][Tt][Ii][Cc]*.bed; do
                    if [[ -f "$candidate" ]]; then BED_FILE=$(realpath "$candidate"); break; fi
                done
                if [[ -n "$BED_FILE" ]]; then echo -e "${GREEN}✓ Found ARTIC BED: ${BOLD}$BED_FILE${NC}"; break; fi
                read -r -p "${CYAN}Enter the path to your ARTIC BED file: ${NC}" candidate
                if [[ -f "$candidate" ]]; then BED_FILE=$(realpath "$candidate"); break; fi
                echo -e "${RED}❌ BED file not found. Please try again.${NC}" ;;
            3)
                PRIMER_SCHEME="CUSTOM"; CUSTOM_BED=1
                read -r -p "${CYAN}Enter the path to your BED file: ${NC}" candidate
                if [[ -f "$candidate" ]]; then BED_FILE=$(realpath "$candidate"); echo -e "${GREEN}✓ Selected custom BED: ${BOLD}$BED_FILE${NC}"; break; fi
                echo -e "${RED}❌ BED file not found. Please enter a valid path.${NC}" ;;
            *) echo -e "${RED}❌ Invalid choice. Please enter 1, 2, or 3.${NC}" ;;
        esac
    done
    echo ""
}

# Function to choose depth threshold
choose_depth_threshold() {
    while true; do
        echo -e "${MAGENTA}📊 Choose your minimum depth for filtering and masking:${NC}"
        echo -e "   ${GREEN}[1]${NC} ≥20×  (Standard - good for most samples)"
        echo -e "   ${GREEN}[2]${NC} ≥50×  (Moderate - better quality)"
        echo -e "   ${GREEN}[3]${NC} ≥100× (High - high confidence regions only)"
        echo -e "   ${GREEN}[4]${NC} ≥500× (Very High - ultra-high confidence only)"
        echo ""
        echo -e "${YELLOW}💡 Tip: Higher thresholds = more stringent filtering = smaller consensus${NC}"
        echo ""
        read -p "$(echo -e "${CYAN}Enter your choice [1-4]: ${NC}")" choice
        
        case $choice in
            1)
                DEPTH_THRESHOLD=20
                echo -e "${GREEN}✓ Selected minimum depth: ≥20× (Standard)${NC}"
                break
                ;;
            2)
                DEPTH_THRESHOLD=50
                echo -e "${GREEN}✓ Selected minimum depth: ≥50× (Moderate)${NC}"
                break
                ;;
            3)
                DEPTH_THRESHOLD=100
                echo -e "${GREEN}✓ Selected minimum depth: ≥100× (High)${NC}"
                break
                ;;
            4)
                DEPTH_THRESHOLD=500
                echo -e "${GREEN}✓ Selected minimum depth: ≥500× (Very High)${NC}"
                break
                ;;
            *)
                echo -e "${RED}❌ Invalid choice. Please enter a number between 1 and 4.${NC}"
                ;;
        esac
    done
    echo ""
}

# Function to choose compute settings and the Medaka model
choose_runtime_settings() {
    local detected_threads choice
    detected_threads=$(nproc 2>/dev/null || echo 1)
    if [[ -z "$THREADS" ]]; then
        while true; do
            read -r -p "$(echo -e "${CYAN}Number of CPU threads [$detected_threads]: ${NC}")" THREADS
            THREADS="${THREADS:-$detected_threads}"
            [[ "$THREADS" =~ ^[1-9][0-9]*$ ]] && break
            echo -e "${RED}❌ Threads must be a positive integer.${NC}"
        done
    fi
    if [[ -z "$MODEL_QUALITY" ]]; then
        while true; do
            echo -e "${MAGENTA}🧠 Which basecalling model was used?${NC}"
            echo -e "   ${GREEN}[1]${NC} HAC (High Accuracy)"
            echo -e "   ${GREEN}[2]${NC} SUP (Super Accuracy)"
            read -r -p "$(echo -e "${CYAN}Enter your choice [1/2]: ${NC}")" choice
            case "$choice" in
                1|[Hh][Aa][Cc]) MODEL_QUALITY=hac; break ;;
                2|[Ss][Uu][Pp]) MODEL_QUALITY=sup; break ;;
                *) echo -e "${RED}❌ Select HAC or SUP.${NC}" ;;
            esac
        done
    fi
    case "$MODEL_QUALITY" in
        hac) MODEL="r1041_e82_400bps_hac_v5.0.0" ;;
        sup) MODEL="r1041_e82_400bps_sup_v5.0.0" ;;
    esac
    echo -e "${GREEN}✓ Threads: $THREADS${NC}"
    echo -e "${GREEN}✓ Medaka model: $MODEL${NC}"
    echo -e "${GREEN}✓ Medaka image: $MEDAKA_IMAGE${NC}"
    echo ""
}

# Configure optional iVar minority-variant calling.
choose_minority_settings() {
    while true; do
        echo -e "${MAGENTA}🧬 Detect minority variants?${NC}"
        echo -e "   ${GREEN}[1]${NC} No"
        echo -e "   ${GREEN}[2]${NC} Yes"
        read -r -p "$(echo -e "${CYAN}Enter your choice [1/2]: ${NC}")" choice
        case "$choice" in
            1) MINORITY_ENABLED=0; echo -e "${GREEN}✓ Minority-variant calling disabled${NC}"; break ;;
            2) MINORITY_ENABLED=1; break ;;
            *) echo -e "${RED}❌ Invalid choice. Please enter 1 or 2.${NC}" ;;
        esac
    done

    if [[ "$MINORITY_ENABLED" == "1" ]]; then
        echo -e "${CYAN}Publication filter: AF 20–<50%, total depth ≥200×, alternate reads ≥20, base quality ≥20${NC}"
        echo -e "${CYAN}Additional checks: alternate support on both strands and exclusion of 100-bp reference edges${NC}"
    fi
    echo ""
}

# Function to find and validate reference and BED files
find_reference_files() {
    # Look for reference and BED files in home directory and current directory
    REF_FILE=""
    BED_FILE="${BED_FILE:-}"
    CUSTOM_BED="${CUSTOM_BED:-0}"
    
    # Search locations
    search_dirs=("$HOME" ".")
    
    echo -e "${CYAN}[SEARCH] ${WHITE}Looking for reference and BED files...${NC}"
    
    # Find reference file
    for dir in "${search_dirs[@]}"; do
        if [[ -f "$dir/$REF_NAME" ]]; then
            REF_FILE=$(realpath "$dir/$REF_NAME")
            echo -e "${GREEN}✓ Found reference: ${BOLD}$REF_FILE${NC}"
            break
        fi
    done
    
    # Find the packaged BED unless ARTIC/custom selection already set BED_FILE.
    if [[ -z "$BED_FILE" ]]; then
        for dir in "${search_dirs[@]}"; do
            if [[ -f "$dir/$BED_NAME" ]]; then
                BED_FILE=$(realpath "$dir/$BED_NAME")
                echo -e "${GREEN}✓ Found primer BED: ${BOLD}$BED_FILE${NC}"
                break
            fi
        done
    else
        echo -e "${GREEN}✓ Using selected primer BED: ${BOLD}$BED_FILE${NC}"
    fi

    
    # Check if files were found
    if [[ -z "$REF_FILE" ]]; then
        echo -e "${RED}❌ Reference file not found: ${BOLD}$REF_NAME${NC}"
        echo -e "${YELLOW}   Please ensure it's in your home directory or current directory${NC}"
        exit 1
    fi
    
    if [[ -z "$BED_FILE" ]]; then
        echo -e "${RED}❌ BED file not found: ${BOLD}$BED_NAME${NC}"
        echo -e "${YELLOW}   Please ensure it's in your home directory or current directory${NC}"
        exit 1
    fi
    GFF_NAME="${REF_NAME%.fasta}.gff3"
    for dir in "${search_dirs[@]}"; do
        if [[ -f "$dir/$GFF_NAME" ]]; then
            GFF_FILE=$(realpath "$dir/$GFF_NAME")
            echo -e "${GREEN}✓ Found annotation GFF3: ${BOLD}$GFF_FILE${NC}"
            break
        fi
    done
    if [[ -z "$GFF_FILE" ]]; then
        echo -e "${YELLOW}⚠ Annotation GFF3 not found; amino-acid annotation will be unavailable${NC}"
    fi
    echo ""
}

# Function to list and choose FASTQ files (multiple selection)
choose_fastq_file() {
    FASTQ_FILES=()
    
    echo -e "${CYAN}🧬 Searching for FASTQ files in: ${INPUT_DIR:-$HOME}...${NC}"
    echo ""
    
    # Find all FASTQ files in selected input directory
    fastq_files=()
    
    # Use find to locate FASTQ files (safer than globbing)
    while IFS= read -r -d '' file; do
        fastq_files+=("$file")
    done < <(find "${INPUT_DIR:-$HOME}" -maxdepth 1 -type f \( -name "*.fastq" -o -name "*.fq" -o -name "*.fastq.gz" -o -name "*.fq.gz" \) -print0 2>/dev/null)
    
    if [[ ${#fastq_files[@]} -eq 0 ]]; then
        echo -e "${RED}❌ No FASTQ files found in your home directory!${NC}"
        echo -e "${YELLOW}   Please ensure your FASTQ file is in: ${INPUT_DIR:-$HOME}${NC}"
        echo -e "${YELLOW}   Supported formats: .fastq, .fq, .fastq.gz, .fq.gz${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}📋 Found ${#fastq_files[@]} FASTQ file(s):${NC}"
    echo ""
    
    # Display numbered list of files
    for i in "${!fastq_files[@]}"; do
        filename=$(basename "${fastq_files[$i]}")
        echo -e "   ${CYAN}[$((i+1))]${NC} $filename"
    done
    echo ""
    
    # Let user choose multiple files
    echo -e "${YELLOW}💡 You can select multiple files by entering numbers separated by commas or spaces${NC}"
    echo -e "${YELLOW}   Example: 1,2,3 or 1 2 3${NC}"
    echo ""
    
    while true; do
        read -p "$(echo -e "${WHITE}Enter file number(s) [1-${#fastq_files[@]}] (or 'all' for all files): ${NC}")" choice
        
        # Handle 'all' option
        if [[ "$choice" =~ ^[Aa][Ll][Ll]$ ]]; then
            FASTQ_FILES=("${fastq_files[@]}")
            echo -e "${GREEN}✓ Selected all ${#FASTQ_FILES[@]} file(s):${NC}"
            for file in "${FASTQ_FILES[@]}"; do
                echo -e "   ${GREEN}•${NC} ${BOLD}$(basename "$file")${NC}"
            done
            break
        fi
        
        # Parse multiple selections (comma or space separated)
        IFS=', ' read -ra selections <<< "$choice"
        valid_selection=true
        selected_indices=()
        
        for sel in "${selections[@]}"; do
            # Remove any whitespace
            sel=$(echo "$sel" | xargs)
            
            if [[ "$sel" =~ ^[0-9]+$ ]] && [[ "$sel" -ge 1 ]] && [[ "$sel" -le ${#fastq_files[@]} ]]; then
                idx=$((sel-1))
                # Check if already selected
                if [[ ! " ${selected_indices[@]} " =~ " ${idx} " ]]; then
                    selected_indices+=("$idx")
                fi
            else
                valid_selection=false
                break
            fi
        done
        
        if [[ "$valid_selection" == true ]] && [[ ${#selected_indices[@]} -gt 0 ]]; then
            # Add selected files to FASTQ_FILES array
            for idx in "${selected_indices[@]}"; do
                FASTQ_FILES+=("${fastq_files[$idx]}")
            done
            echo -e "${GREEN}✓ Selected ${#FASTQ_FILES[@]} file(s):${NC}"
            for file in "${FASTQ_FILES[@]}"; do
                echo -e "   ${GREEN}•${NC} ${BOLD}$(basename "$file")${NC}"
            done
            break
        else
            echo -e "${RED}❌ Invalid choice. Please enter valid number(s) between 1 and ${#fastq_files[@]}, separated by commas or spaces.${NC}"
        fi
    done
    echo ""
}

# Cleanup function
cleanup() {
    local sample_outdir="$1"
    local medaka_dir="${sample_outdir}/medaka_out"
    if [[ -d "$medaka_dir" && "$medaka_dir" == "$sample_outdir/medaka_out" ]]; then
        echo -e "${YELLOW}[CLEANUP] Removing temporary directory: $medaka_dir${NC}"
        rm -rf -- "$medaka_dir"
    fi
}

# Function to check dependencies
check_dependencies() {
    echo -e "${CYAN}[DEPENDENCIES] ${WHITE}Checking required tools...${NC}"
    deps=(minimap2 samtools ivar bcftools tabix docker awk find realpath sed nproc)
    missing_deps=()
    
    for dep in "${deps[@]}"; do
        if command -v "$dep" &>/dev/null; then
            echo -e "${GREEN}✓ $dep${NC}"
        else
            echo -e "${RED}❌ $dep${NC}"
            missing_deps+=("$dep")
        fi
    done
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        echo -e "${RED}Missing dependencies: ${missing_deps[*]}${NC}"
        echo -e "${YELLOW}Install missing tools using the documented Conda/Mamba environment.${NC}"
        exit 1
    fi
    if ! docker info &>/dev/null && ! sudo -n docker info &>/dev/null; then
        echo -e "${RED}❌ Docker is installed but is not accessible to this user.${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ All dependencies found!${NC}"
    echo ""
}

# Process a single FASTQ file
process_single_file() (
    local FASTQ_FILE="$1"
    local SAMPLE_NAME
    SAMPLE_NAME=$(basename "$FASTQ_FILE" | sed 's/\.\(fastq\|fq\)\(\.gz\)\?$//')
    local OUTDIR="${BASE_OUTDIR}/${SAMPLE_NAME}"
    
    echo ""
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${MAGENTA}🚀 Processing: ${BOLD}$(basename "$FASTQ_FILE")${NC}"
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}Output directory: ${BOLD}$OUTDIR${NC}"
    echo ""
    
    mkdir -p "$OUTDIR"
    cd "$OUTDIR" || { echo "Failed to enter $OUTDIR"; exit 1; }

    validate_fastq() {
        [[ -s "$FASTQ_FILE" ]] || { echo "Error: FASTQ is empty: $FASTQ_FILE"; exit 1; }
        if [[ "$FASTQ_FILE" == *.gz ]]; then gzip -t "$FASTQ_FILE" || { echo "Error: invalid gzip FASTQ: $FASTQ_FILE"; exit 1; }; fi
    }
    validate_fastq
    if [[ "$AUTO_DETECT" == "1" ]]; then
        A_REF="$(dirname "$REF_FILE")/PP109421.1.fasta"; B_REF="$(dirname "$REF_FILE")/OP975389.1.fasta"
        A_MAPPED=$(minimap2 -a -t "$THREADS" "$A_REF" "$FASTQ_FILE" 2>/dev/null | samtools view -c -F 4 -)
        B_MAPPED=$(minimap2 -a -t "$THREADS" "$B_REF" "$FASTQ_FILE" 2>/dev/null | samtools view -c -F 4 -)
        if (( A_MAPPED > B_MAPPED * 2 )); then RSV_TYPE="A"; REF_NAME="PP109421.1.fasta"; BED_NAME="RSV_750_primers_PP109421.bed"; elif (( B_MAPPED > A_MAPPED * 2 )); then RSV_TYPE="B"; REF_NAME="OP975389.1.fasta"; BED_NAME="RSV_750_primers_OP975389.bed"; else echo "Ambiguous subtype for $SAMPLE_NAME (A=$A_MAPPED, B=$B_MAPPED); skipping sample"; return 1; fi
        REF_FILE="$(dirname "$A_REF")/$REF_NAME"; BED_FILE="$(dirname "$A_REF")/$BED_NAME"; GFF_NAME="${REF_NAME%.fasta}.gff3"; GFF_FILE="$(dirname "$A_REF")/$GFF_NAME"
    fi
    sha256sum "$FASTQ_FILE" > input.sha256
    sha256sum "$REF_FILE" > reference.sha256
    sha256sum "$BED_FILE" > primers.sha256
    [[ -n "$GFF_FILE" ]] && sha256sum "$GFF_FILE" > annotation.sha256
    { echo "pipeline_version	$VERSION"; echo "sample	$SAMPLE_NAME"; echo "rsv_type	$RSV_TYPE"; echo "reference	$(basename "$REF_FILE")"; echo "primer_bed	$(basename "$BED_FILE")"; echo "depth_threshold	$DEPTH_THRESHOLD"; echo "threads	$THREADS"; echo "medaka_model	$MODEL"; echo "minority_enabled	$MINORITY_ENABLED"; echo "minority_af	$MINORITY_AF"; echo "minority_depth	$MINORITY_MIN_DEPTH"; echo "minority_alt_reads	$MINORITY_MIN_ALT_READS"; echo "minority_base_quality	$MINORITY_MIN_BQ"; } > run_manifest.tsv
    
    # Set up cleanup trap if KEEP_TEMP is not set
    if [ "$KEEP_TEMP" != "1" ]; then
        trap 'cleanup "$OUTDIR"' EXIT
    fi
    
    # Step 1: Alignment
    echo -e "${CYAN}[1/8] ${WHITE}🧬 Aligning reads with minimap2...${NC}"
    minimap2 -ax map-ont -t "$THREADS" "$REF_FILE" "$FASTQ_FILE" > aln.sam
    samtools view -@ "$THREADS" -bS aln.sam > aln.bam
    samtools sort -@ "$THREADS" aln.bam -o aln.sorted.bam
    samtools index aln.sorted.bam
    samtools flagstat aln.sorted.bam > flagstat.txt
    echo -e "${GREEN}✓ Alignment complete${NC}"
    
    # Step 2: Primer trimming
    echo -e "${CYAN}[2/8] ${WHITE}✂️  Trimming primers with ivar...${NC}"
    ivar trim -b "$BED_FILE" \
              -i aln.sorted.bam \
              -p trimmed.bam \
              -q 1 -m 10 -s 4 -e
    samtools sort -@ "$THREADS" trimmed.bam -o trimmed.sorted.bam
    samtools index trimmed.sorted.bam
    echo -e "${GREEN}✓ Primer trimming complete${NC}"
    

    # Optional minority-variant calling on primer-trimmed reads.
    if [[ "$MINORITY_ENABLED" == "1" ]]; then
        echo -e "${CYAN}[M] ${WHITE}🧬 Calling minority variants with iVar...${NC}"
        IVAR_GFF_ARGS=(); [[ -n "$GFF_FILE" ]] && IVAR_GFF_ARGS=(-g "$GFF_FILE")
        samtools mpileup -aa -A -d 0 -B -Q 0 --reference "$REF_FILE" trimmed.sorted.bam | \
            ivar variants -p minority_variants -q "$MINORITY_MIN_BQ" -t "$MINORITY_AF" -m "$MINORITY_MIN_DEPTH" -r "$REF_FILE" "${IVAR_GFF_ARGS[@]}"
        if [[ -f minority_variants.tsv ]]; then
            REF_LENGTH=$(awk '!/^>/ {n += length($0)} END {print n+0}' "$REF_FILE")
            awk -v min_alt="$MINORITY_MIN_ALT_READS" -v min_freq="$MINORITY_AF" -v max_freq="$MINORITY_MAX_AF" -v edge="$MINORITY_EDGE" -v ref_len="$REF_LENGTH" -v min_bq="$MINORITY_MIN_BQ" -v min_depth="$MINORITY_MIN_DEPTH" 'BEGIN {FS=OFS="\t"} NR==1 {for (i=1; i<=NF; i++) {if ($i == "ALT_DP") alt=i; if ($i == "ALT_FREQ") freq=i; if ($i == "ALT_RV") rev=i; if ($i == "ALT_QUAL") qual=i; if ($i == "TOTAL_DP") depth=i; if ($i == "POS") pos=i} if (!alt || !freq || !rev || !qual || !depth || !pos) {print "ERROR: iVar output lacks required columns" > "/dev/stderr"; exit 2} print; next} alt && freq && rev && qual && depth && pos && $(alt) >= min_alt && $(qual) >= min_bq && $(depth) >= min_depth && $(freq) >= min_freq && $(freq) < max_freq && $(rev) > 0 && ($(alt)-$(rev)) > 0 && $(pos) > edge && $(pos) <= (ref_len-edge) {print}' minority_variants.tsv > minority_variants.filtered.tsv
            echo -e "${GREEN}✓ Minority variants written to minority_variants.tsv and minority_variants.filtered.tsv${NC}"
        else
            echo -e "${YELLOW}⚠ iVar did not produce minority_variants.tsv${NC}"
        fi
    fi

    # Step 3: Medaka polishing
    echo -e "${CYAN}[3/8] ${WHITE}🔬 Running Medaka polishing (Docker)...${NC}"
    ABS_OUT=$(pwd)
    # Determine docker command based on group membership
    if docker info &>/dev/null; then
        DOCKER_CMD=(docker)
    else
        DOCKER_CMD=(sudo docker)
    fi
    "${DOCKER_CMD[@]}" run --rm \
      --user "$(id -u):$(id -g)" \
      -v "$ABS_OUT":/data \
      -v "$(dirname "$REF_FILE")":/ref \
      --cpus="$THREADS" \
          "$MEDAKA_IMAGE" \
          medaka_consensus \
             -i /data/trimmed.sorted.bam \
             -d /ref/$(basename "$REF_FILE") \
             -o /data/medaka_out \
             -m "$MODEL" \
             -t "$THREADS"
    echo -e "${GREEN}✓ Medaka polishing complete${NC}"
    
    # Step 4: Variant calling
    echo -e "${CYAN}[4/8] ${WHITE}📊 Calling variants from Medaka...${NC}"
    "${DOCKER_CMD[@]}" run --rm \
      --user "$(id -u):$(id -g)" \
      -v "$ABS_OUT":/data \
      -v "$(dirname "$REF_FILE")":/ref \
      "$MEDAKA_IMAGE" \
      medaka vcf \
         /data/medaka_out/consensus_probs.hdf \
         /ref/$(basename "$REF_FILE") \
         /data/medaka_out/consensus.vcf
    echo -e "${GREEN}✓ Variant calling complete${NC}"
    
    # Step 5: Annotation
    echo -e "${CYAN}[5/8] ${WHITE}🏷️  Annotating variants...${NC}"
    "${DOCKER_CMD[@]}" run --rm \
      --user "$(id -u):$(id -g)" \
      -v "$ABS_OUT":/data \
      -v "$(dirname "$REF_FILE")":/ref \
      "$MEDAKA_IMAGE" \
      medaka tools annotate \
         --pad 25 \
         /data/medaka_out/consensus.vcf \
         /ref/$(basename "$REF_FILE") \
         /data/trimmed.sorted.bam \
         /data/medaka_out/consensus.annotated.vcf
    echo -e "${GREEN}✓ Variant annotation complete${NC}"
    
    # Step 6: Filtering (using chosen depth threshold)
    echo -e "${CYAN}[6/8] ${WHITE}🔍 Filtering variants (depth ≥${DEPTH_THRESHOLD}×)...${NC}"
    bcftools filter -e 'ALT="."' medaka_out/consensus.annotated.vcf | \
      bcftools filter -Oz -e "INFO/DP<$DEPTH_THRESHOLD" -o consensus.filtered.vcf.gz
    tabix -f consensus.filtered.vcf.gz
    echo -e "${GREEN}✓ Variant filtering complete${NC}"
    
    # Step 7: Coverage analysis (using chosen depth threshold)
    echo -e "${CYAN}[7/8] ${WHITE}📈 Analyzing coverage (masking depth <${DEPTH_THRESHOLD}×)...${NC}"
    samtools depth -a trimmed.sorted.bam > depth.txt
    awk -v threshold="$DEPTH_THRESHOLD" '{if ($3<threshold) print $1"\t"$2-1"\t"$2}' depth.txt > mask.bed
    echo -e "${GREEN}✓ Coverage analysis complete${NC}"
    
    # Step 8: Final consensus
    echo -e "${CYAN}[8/8] ${WHITE}🎯 Creating final consensus...${NC}"
    bcftools consensus \
       --mask mask.bed \
       --fasta-ref "$REF_FILE" \
       -o consensus.masked.fasta \
       consensus.filtered.vcf.gz
    echo -e "${GREEN}✓ Consensus generation complete${NC}"
    # Consensus-level amino-acid annotation using the matching GFF3.
    if [[ -n "$GFF_FILE" && -x "$SCRIPT_DIR/consensus-aa.sh" ]]; then
        echo -e "${CYAN}[9/9] ${WHITE}🧬 Creating consensus amino-acid report...${NC}"
        "$SCRIPT_DIR/consensus-aa.sh" "$OUTDIR" "$REF_FILE"
        echo -e "${GREEN}✓ Consensus amino-acid report complete${NC}"
        if [[ -x "$SCRIPT_DIR/make-report.rb" ]]; then
            "$SCRIPT_DIR/make-report.rb" "$OUTDIR" "$REF_FILE" "$DEPTH_THRESHOLD"
        fi
        # Validated RSV lineage assignment with Nextclade.
        if command -v conda >/dev/null 2>&1 && conda run -n viral nextclade --version >/dev/null 2>&1; then
            NC_DATASET="$( [[ "$RSV_TYPE" == "A" ]] && echo rsv_a || echo rsv_b )"
            echo -e "${CYAN}[10/10] ${WHITE}🧬 Assigning RSV lineage with Nextclade (${NC_DATASET})...${NC}"
            if conda run -n viral nextclade run --dataset-name "$NC_DATASET" --output-csv "$OUTDIR/nextclade_report.csv" --output-json "$OUTDIR/nextclade_results.json" "$OUTDIR/consensus.masked.fasta" >/dev/null 2>"$OUTDIR/nextclade.log"; then
                NC_LINEAGE="$(awk -F";" "NR==2{print \$3}" "$OUTDIR/nextclade_report.csv")"
                printf "lineage\t%s\n" "${NC_LINEAGE:-Not assigned}" >> run_manifest.tsv
                echo -e "${GREEN}✓ Nextclade lineage: ${NC_LINEAGE:-Not assigned}${NC}"
            else
                echo -e "${YELLOW}⚠ Nextclade failed; see nextclade.log${NC}"
            fi
        else
            echo -e "${YELLOW}⚠ Nextclade unavailable (conda environment viral required)${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Consensus amino-acid report skipped (GFF3 or consensus-aa.sh unavailable)${NC}"
    fi
    
    # Success message for this file
    echo ""
    echo -e "${GREEN}✓ ${BOLD}$(basename "$FASTQ_FILE")${NC} processing complete!"
    echo -e "${CYAN}   Output: ${BOLD}$OUTDIR${NC}"
    echo ""
)

# Main pipeline execution - processes all selected files
run_pipeline() {
    BASE_OUTDIR="${START_DIR}/nanopore_output_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$BASE_OUTDIR"
    exec > >(tee "$BASE_OUTDIR/run.log") 2> >(tee -a "$BASE_OUTDIR/run.log" >&2)
    { echo -e "tool\t$PROGRAM_NAME"; echo -e "version\t$VERSION"; echo -e "date\t$(date -Is)"; } > "$BASE_OUTDIR/software_versions.txt"
    for tool in minimap2 samtools ivar bcftools tabix docker; do command -v "$tool" >/dev/null 2>&1 && "$tool" --version 2>&1 | head -1 >> "$BASE_OUTDIR/software_versions.txt" || true; done
    
    echo -e "${MAGENTA}🚀 Starting pipeline for ${#FASTQ_FILES[@]} file(s)...${NC}"
    echo ""
    
    # Process each file. Guarded with if/! so that set -e does not abort the
    # whole batch when one sample fails or is skipped (e.g. ambiguous
    # auto-detected subtype) — the remaining samples still get processed.
    FAILED_FILES=()
    for FASTQ_FILE in "${FASTQ_FILES[@]}"; do
        if ! process_single_file "$FASTQ_FILE"; then
            echo -e "${RED}⚠ $(basename "$FASTQ_FILE") failed or was skipped — continuing with remaining samples${NC}"
            FAILED_FILES+=("$FASTQ_FILE")
        fi
    done
    
    if [[ -x "$SCRIPT_DIR/make-run-report.rb" ]]; then
        "$SCRIPT_DIR/make-run-report.rb" "$BASE_OUTDIR"
    fi

    # Final summary — reflects actual outcome now that a failed/skipped
    # sample no longer aborts the batch (see FAILED_FILES above).
    echo ""
    if [[ ${#FAILED_FILES[@]} -eq 0 ]]; then
        echo -e "${GREEN}🎉 ${BOLD}ALL FILES PROCESSED SUCCESSFULLY!${NC} 🎉"
    else
        echo -e "${YELLOW}⚠ ${BOLD}COMPLETED WITH ${#FAILED_FILES[@]} FAILED/SKIPPED SAMPLE(S)${NC} ⚠"
    fi
    echo ""
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${WHITE}                        📁 OUTPUT LOCATION                        ${BLUE}║${NC}"
    echo -e "${BLUE}╠══════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${BLUE}║${NC} ${CYAN}Base Directory:${NC} ${BOLD}$BASE_OUTDIR${NC}${BLUE}              ║${NC}"
    echo -e "${BLUE}║${NC}                                                                  ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC} ${WHITE}Processed $((${#FASTQ_FILES[@]} - ${#FAILED_FILES[@]}))/${#FASTQ_FILES[@]} sample(s) successfully:${NC}     ${BLUE}║${NC}"
    for FASTQ_FILE in "${FASTQ_FILES[@]}"; do
        [[ " ${FAILED_FILES[*]:-} " == *" ${FASTQ_FILE} "* ]] && continue
        SAMPLE_NAME=$(basename "$FASTQ_FILE" | sed 's/\.\(fastq\|fq\)\(\.gz\)\?$//')
        echo -e "${BLUE}║${NC}   ${GREEN}•${NC} ${BOLD}${SAMPLE_NAME}/${NC} - Contains all output files        ${BLUE}║${NC}"
    done
    if [[ ${#FAILED_FILES[@]} -gt 0 ]]; then
        echo -e "${BLUE}║${NC}                                                                  ${BLUE}║${NC}"
        echo -e "${BLUE}║${NC} ${YELLOW}Failed or skipped:${NC}                                             ${BLUE}║${NC}"
        for FASTQ_FILE in "${FAILED_FILES[@]}"; do
            echo -e "${BLUE}║${NC}   ${RED}•${NC} ${BOLD}$(basename "$FASTQ_FILE")${NC}        ${BLUE}║${NC}"
        done
    fi
    echo -e "${BLUE}║${NC}                                                                  ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC} ${WHITE}Key files in each subdirectory:${NC}                              ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC}   ${GREEN}•${NC} ${BOLD}consensus.masked.fasta${NC} - Final genome sequence      ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC}   ${GREEN}•${NC} ${BOLD}consensus.filtered.vcf.gz${NC} - Filtered variants       ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC}   ${GREEN}•${NC} ${BOLD}flagstat.txt${NC} - Alignment statistics              ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC}   ${GREEN}•${NC} ${BOLD}depth.txt${NC} - Coverage information                 ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Show filtering stats
    echo -e "${YELLOW}📊 Applied minimum depth: ≥${DEPTH_THRESHOLD}× coverage${NC}"
    echo ""
    
    # Final message
    echo -e "${MAGENTA}🦠 ${YELLOW}Thanks for using the RSV Nanopore Pipeline! ${MAGENTA}🦠${NC}"
    echo -e "${CYAN}                    ${BOLD}Have a nice day! 😊${NC}"
    echo ""
}

# Main execution
main() {
    # Parse command line arguments
    KEEP_TEMP="${KEEP_TEMP:-0}"
    while [[ $# -gt 0 ]]; do
        case $1 in
            --keep)
                KEEP_TEMP=1
                shift
                ;;
            --threads)
                [[ $# -ge 2 ]] || { echo "Error: --threads requires a value" >&2; exit 2; }
                THREADS="$2"; [[ "$THREADS" =~ ^[1-9][0-9]*$ ]] || { echo "Error: invalid threads" >&2; exit 2; }
                shift 2 ;;
            --input-dir)
                [[ $# -ge 2 && -d "$2" ]] || { echo "Error: --input-dir requires an existing directory" >&2; exit 2; }
                INPUT_DIR=$(realpath "$2"); shift 2 ;;
            --model)
                [[ $# -ge 2 ]] || { echo "Error: --model requires hac or sup" >&2; exit 2; }
                MODEL_QUALITY="${2,,}"; [[ "$MODEL_QUALITY" == hac || "$MODEL_QUALITY" == sup ]] || { echo "Error: invalid model" >&2; exit 2; }
                shift 2 ;;
            --help|-h)
                echo "$PROGRAM_NAME v$VERSION"; echo "Usage: $(basename "$0") [--keep] [--input-dir DIR] [--threads N] [--model hac|sup]"; exit 0 ;;
            --version) echo "$PROGRAM_NAME v$VERSION"; exit 0 ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}" >&2
                echo "Use --help for usage." >&2
                exit 2
                ;;
        esac
    done
    
    show_intro
    choose_rsv_type
    choose_primer_scheme
    choose_depth_threshold
    choose_runtime_settings
    choose_minority_settings
    check_dependencies
    choose_fastq_file
    find_reference_files
    if [[ "$AUTO_DETECT" == "1" ]]; then
        A_REF="$REF_FILE"; B_REF="$(dirname "$A_REF")/OP975389.1.fasta"
        TEST_FASTQ="${FASTQ_FILES[0]}"
        echo -e "${CYAN}🔎 Comparing RSV-A and RSV-B mapping...${NC}"
        A_MAPPED=$(minimap2 -a -t "$THREADS" "$A_REF" "$TEST_FASTQ" 2>/dev/null | samtools view -c -F 4 -)
        B_MAPPED=$(minimap2 -a -t "$THREADS" "$B_REF" "$TEST_FASTQ" 2>/dev/null | samtools view -c -F 4 -)
        echo "   RSV-A mapped reads: $A_MAPPED"; echo "   RSV-B mapped reads: $B_MAPPED"
        if (( A_MAPPED > B_MAPPED * 2 )); then RSV_TYPE="A"; REF_NAME="PP109421.1.fasta"; BED_NAME="RSV_750_primers_PP109421.bed"; elif (( B_MAPPED > A_MAPPED * 2 )); then RSV_TYPE="B"; REF_NAME="OP975389.1.fasta"; BED_NAME="RSV_750_primers_OP975389.bed"; else echo "Ambiguous subtype; choose manually."; AUTO_DETECT=0; choose_rsv_type; fi
        [[ "$AUTO_DETECT" == "1" ]] && find_reference_files
    fi
    
    echo -e "${YELLOW}🚀 Ready to start processing!${NC}"
    echo -e "${CYAN}   RSV Type: ${BOLD}$RSV_TYPE${NC}"
    echo -e "${CYAN}   Reference: ${BOLD}$(basename "$REF_FILE")${NC}"
    echo -e "${CYAN}   Primer Scheme: ${BOLD}$PRIMER_SCHEME${NC}"
    echo -e "${CYAN}   Minority Variants: ${BOLD}$([[ "$MINORITY_ENABLED" == "1" ]] && echo enabled || echo disabled)${NC}"
    echo -e "${CYAN}   Primers: ${BOLD}$(basename "$BED_FILE")${NC}"
    echo -e "${CYAN}   Samples (${#FASTQ_FILES[@]} file(s)):${NC}"
    for file in "${FASTQ_FILES[@]}"; do
        echo -e "${CYAN}      • ${BOLD}$(basename "$file")${NC}"
    done
    echo -e "${CYAN}   Minimum Depth: ${BOLD}≥${DEPTH_THRESHOLD}×${NC}"
    echo -e "${CYAN}   Threads: ${BOLD}$THREADS${NC}"
    echo -e "${CYAN}   Medaka Model: ${BOLD}$MODEL${NC}"
    echo -e "${CYAN}   Medaka Image: ${BOLD}$MEDAKA_IMAGE${NC}"
    echo ""
    
    read -p "$(echo -e "${GREEN}Continue? [Y/n]: ${NC}")" confirm
    if [[ $confirm =~ ^[Nn]$ ]]; then
        echo -e "${YELLOW}Pipeline cancelled. Have a nice day! 👋${NC}"
        exit 0
    fi
    
    run_pipeline
}

# Run the main function
main "$@"